# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://marktech:marktech_dev@localhost:5433/marktech_ads

# ─── Redis (used by packages/worker) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Server ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=3001
NODE_ENV=development
JWT_SECRET=change_me_in_production_32_chars_min
FRONTEND_URL=http://localhost:5173

# ─── Meta Marketing API (OAuth) ──────────────────────────────
# Apply at: https://developers.facebook.com/apps/
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/auth/meta/callback

# ─── Google Ads API (OAuth) ──────────────────────────────────
# Apply at: https://developers.google.com/google-ads/api/docs/get-started/introduction
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3001/auth/google/callback
GOOGLE_ADS_MANAGER_ACCOUNT_ID=

# ─── Shopify (OAuth) ──────────────────────────────────────────
# No global SHOPIFY_CLIENT_ID/SECRET here on purpose — each client registers
# their own Shopify app (Client ID/Secret), entered per-client from the admin
# panel (Connections tab), not a shared env var. Only the callback URL is
# global, since every client's app redirects to this same server route.
SHOPIFY_REDIRECT_URI=http://localhost:3001/auth/shopify/callback

# ─── OpenAI (Insights engine) ─────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Frontend ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001
